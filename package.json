{
  "name": "tuiline",
  "version": "1.5.1",
  "description": "Terminal UI client for LINE Messenger",
  "keywords": [
    "line",
    "tui",
    "terminal",
    "cli",
    "vim",
    "opentui"
  ],
  "author": "Leonid Shutov <leonid.shutov@hey.com>",
  "license": "MIT",
  "homepage": "https://github.com/kuokuo123/tuiline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuokuo123/tuiline.git"
  },
  "bugs": {
    "url": "https://github.com/kuokuo123/tuiline/issues"
  },
  "bin": {
    "tuiline": "bin/tuiline.js"
  },
  "files": [
    "app-key.json",
    "bin",
    "src",
    "types",
    "CHANGELOG.md",
    "README.md",
    "line-tui",
    "backend-bin",
    "backend",
    "scripts/build-line.js",
    "scripts/line-patches.js"
  ],
  "engines": {
    "node": ">=26.4.0"
  },
  "scripts": {
    "dev": "node bin/tuiline.js",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint .",
    "types": "tsc -p tsconfig.json",
    "test": "node --experimental-ffi --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "prepublishOnly": "npm run lint && npm run types && npm test",
    "build:line": "node scripts/build-line.js",
    "dev:telegram": "node bin/telegram.js"
  },
  "dependencies": {
    "@leonid-shutov/uncommonjs": "^2.0.0",
    "@mtcute/dispatcher": "^0.32.5",
    "@mtcute/node": "^0.32.5",
    "@opentui/core": "^0.5.7",
    "@opentui/keymap": "^0.5.11",
    "@opentui/qrcode": "^0.5.7",
    "metautil": "6.0.0-alpha.0",
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "@mtcute/test": "^0.32.5",
    "@mtcute/web": "^0.32.5",
    "@types/node": "^26.4.0",
    "eslint": "^9.36.0",
    "eslint-config-metarhia": "^9.1.3",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
